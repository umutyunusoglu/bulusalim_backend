{
    "compilerOptions": {
        // En güncel ve modern Node.js modül çözünürlüğünü kullan
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // Target modern ES versiyonu
        "target": "ES2020",
        // Tip kontrolünü aç
        "strict": true,
        // Çıktı klasörü (aslında ts-node ile buna ihtiyacınız yok ama standarttır)
        "outDir": "./dist",
        // Kaynak haritalarını etkinleştir
        "sourceMap": true,
        // Hangi dosyaların derleneceğini belirt (örnek)
        "rootDir": "./"
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}