service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // --- 1. USERS ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /eventLog/{eventId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        
        // KRİTİK: Bir katılımcı onaylandığında/reddedildiğinde, 
        // etkinliğin kurucusu o katılımcının loguna durum yazabilmeli.
        allow write, update: if isSignedIn() && (
          request.auth.uid == userId || 
          get(/databases/$(database)/documents/events/$(eventId)).data.creator.userID == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        );
      }

      match /notifications/{docId} { allow write: if isSignedIn(); }
      
      match /{col}/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- 2. POSTS ---
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creator.userID == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creator.userID ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoteCounts'])
      );
      allow delete: if isSignedIn() && resource.data.creator.userID == request.auth.uid;
      match /emotes/{id} { allow read, write: if isSignedIn(); }
    }

    // --- 3. EVENTS ---
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creator.userID == request.auth.uid;
      
      // Kurucu her şeyi günceller, katılımcı ayrılırken sadece sayacı düşürür.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creator.userID ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
      );

      allow delete: if isSignedIn() && (
        resource.data.creator.userID == request.auth.uid || 
        resource.data.participantCount <= 1
      );

      // Sensitive Veriler
      match /sensitive/{id} {
        allow read: if isSignedIn() && (
          resource.data.showOnMap == true || 
          exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/events/$(eventId)).data.creator.userID == request.auth.uid
        );
        allow write: if isSignedIn() && 
          get(/databases/$(database)/documents/events/$(eventId)).data.creator.userID == request.auth.uid;
      }
      
      match /messages/{id} {
        allow read, write: if isSignedIn() && (
          exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/events/$(eventId)).data.creator.userID == request.auth.uid
        );
      }

      // Alt Koleksiyonlar (participants, requestPool, rejectedUsers)
      // Transaction sırasında buralara kurucunun yazması gerekir.
      match /participants/{uid} { allow read, write: if isSignedIn(); }
      match /requestPool/{uid} { allow read, write: if isSignedIn(); }
      match /rejectedUsers/{uid} { allow read, write: if isSignedIn(); }

      match /{allSub=**} { allow read, write: if isSignedIn(); }
    }

    match /public_users/{userId} { allow read: if isSignedIn(); allow write: if isSignedIn() && request.auth.uid == userId; }
    match /usernames/{name} { allow read, create: if isSignedIn(); }
  }
}